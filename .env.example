# Database credentials shared by the Compose services.
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=your_postgres_password_here
# Optional host ports; change these if the defaults are occupied.
POSTGRES_PORT=5432
APP_PORT=8080
# Optional Redis host port; the application uses Redis for redirect caching.
REDIS_PORT=6379
# Optional cache lifetime for links without an expiry.
REDIRECT_CACHE_PERMANENT_TTL=PT1H
# Public origin used for generated links; match APP_PORT when running locally.
APP_BASE_URL=http://localhost:8080
# Host-run application only. Compose supplies its internal database URL.
POSTGRES_URL=jdbc:postgresql://localhost:5432/urlshortener

# Optional ISO-8601 v1 management retirement; empty keeps legacy access enabled.
APP_V1_SUNSET=


export PGHOST=localhost
export PGPORT=5432
export PGDATABASE=urlshortener
export PGUSER=urlshortener
export PGPASSWORD='urlshortener'
# Distributed quotas: opt in only after choosing deployment limits.
RATE_LIMIT_ENABLED=false
# Set a random shared secret of at least 32 bytes on every app instance.
RATE_LIMIT_SECRET=
# Required positive integers when enabled; zero is deliberately not a policy default.
RATE_LIMIT_MANAGEMENT=0
RATE_LIMIT_REDIRECT=0
RATE_LIMIT_WINDOW_SECONDS=0

# Bound Redis outages on request paths.
REDIS_CONNECT_TIMEOUT=1s
REDIS_COMMAND_TIMEOUT=1s
